{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "schemas/**/*.ts",
    "packs/_renderer/jobs.ts",
    "packs/_renderer/jobs.test.ts",
    "vitest.config.ts"
  ]
}
