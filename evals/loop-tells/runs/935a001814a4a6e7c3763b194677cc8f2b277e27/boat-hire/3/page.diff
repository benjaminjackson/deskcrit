+/* Below this width the two columns stack: pitch, form, then routes. */
+@media (max-width: 860px) {
+  .page {
+    grid-template-columns: minmax(0, 1fr);
+    row-gap: 40px;
+  }
+
+  .search,
+  .routes {
+    grid-column: 1;
+    grid-row: auto;
+  }
+
+  /* Stacked blocks take the full column, so their right edge meets the nav's. */
+  .hero,
+  .routes ul {
+    max-width: none;
+  }
+
+  /* The full-width form puts its four fields in two columns, so short values do not sit in very long boxes. */
+  .search {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    column-gap: 16px;
+  }
+
+  .search-title,
+  .search button {
+    grid-column: 1 / -1;
+  }
+}
+
+/* Phone: narrower margins, nav on its own row under the logo, smaller headline. */
+@media (max-width: 560px) {
