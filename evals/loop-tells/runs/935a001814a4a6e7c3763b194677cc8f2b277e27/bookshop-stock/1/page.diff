+
+/* Phone and tablet: put the hero and the features in one column. */
+@media (max-width: 900px) {
+  :root {
+    --page-margin: 24px;
+  }
+
+  .hero {
+    flex-direction: column;
+    align-items: stretch;
+    gap: 40px;
+    padding-top: 40px;
+  }
+
+  /* Keep text lines near 550px, so they stay readable while the table uses the full width. */
+  .hero-text {
+    max-width: 550px;
+  }
+
+  .preview {
+    flex: none;
+  }
+
+  .facts {
+    flex-direction: column;
+    gap: 16px;
+  }
+
+  .facts p {
+    flex: none;
+    max-width: 550px;
+  }
+}
+
+/* Phone: a smaller headline and narrower table cells, so the three columns fit. */
+@media (max-width: 480px) {
+  h1 {
+    font-size: 32px;
+  }
+
+  /* Keep each table row on one line. */
+  th,
+  td {
+    padding: 9px 6px;
+    white-space: nowrap;
+  }
+
+  th:first-child,
+  td:first-child {
+    padding-left: 12px;
+  }
+
+  th:last-child,
+  td:last-child {
+    padding-right: 12px;
+  }
+
+  .preview-head {
+    padding: 14px 12px;
+  }
+}
