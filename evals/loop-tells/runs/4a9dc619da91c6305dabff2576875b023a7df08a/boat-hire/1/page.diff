+/* Tablet: stack the form under the text so the lead keeps a readable line length. */
+@media (max-width: 900px) {
+  .hero {
+    flex-direction: column;
+    align-items: stretch;
+    gap: 0;
+  }
+
+  /* "display: contents" removes the text column's own box, so its children become items of the
+     hero column. That lets "order" put the form between the intro text and the routes. */
+  .hero-text {
+    display: contents;
+  }
+
+  /* Cap only the running text for line length; the routes list spans the full width, like the form. */
+  .hero-text > h1,
+  .hero-text > .lead {
+    max-width: 640px;
+  }
+
+  .text-link {
+    align-self: flex-start;
+    margin-bottom: 32px;
+  }
+
+  .search {
+    order: 1;
+    flex: none;
+  }
+
+  .routes {
+    order: 2;
+  }
+}
+
+/* Phone: logo above a single row of nav links, smaller headline, narrower page margins. */
+@media (max-width: 560px) {
