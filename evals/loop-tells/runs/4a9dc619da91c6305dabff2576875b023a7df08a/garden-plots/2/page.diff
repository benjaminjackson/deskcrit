+/* Side padding for every full-width band. It is 64px on normal screens.
+   On screens wider than the 1120px content column plus padding, it grows
+   so the content stays in a centred column of 1120px. */
+:root {
+  --content-width: 1120px;
+  --side-padding: max(64px, calc((100% - var(--content-width)) / 2));
+}
+
