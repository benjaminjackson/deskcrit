+
+/* Tablet and small laptop: the hero text and plot plan stack,
+   and the feature cards go to two columns. */
+@media (max-width: 900px) {
+  .hero {
+    flex-direction: column;
+    align-items: flex-start;
+    gap: 40px;
+  }
+
+  .hero-plan {
+    width: 100%;
+  }
+
+  .cards {
+    grid-template-columns: repeat(2, 1fr);
+  }
+}
+
+/* Phone: narrower side padding, the nav goes on its own row under
+   the logo, and the feature cards go to one column. */
+@media (max-width: 600px) {
+  :root {
+    --side-padding: 20px;
+  }
+
+  .site-header {
+    flex-direction: column;
+    align-items: flex-start;
+    gap: 4px;
+  }
+
+  .site-nav {
+    gap: 0 20px;
+  }
+
+  .hero {
+    padding-top: 40px;
+    padding-bottom: 40px;
+  }
+
+  h1 {
+    font-size: 32px;
+  }
+
+  .hero-plan {
+    padding: 16px;
+  }
+
+  .cards {
+    grid-template-columns: 1fr;
+  }
+}
