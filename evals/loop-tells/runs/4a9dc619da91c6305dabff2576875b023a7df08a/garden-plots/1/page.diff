 .card p {
   margin: 0;
   color: #55604f;
+  /* Ask the browser to balance the last lines, so one short word is not left alone */
+  text-wrap: pretty;
+}
+
+/* Tablet: stack the plot plan under the headline, two cards per row */
+@media (max-width: 900px) {
+  .site-header {
+    padding: 18px 24px;
+  }
+
+  .hero {
+    flex-direction: column;
+    align-items: stretch;
+    gap: 32px;
+    padding: 40px 24px 40px;
+  }
+
+  .hero-plan {
+    width: 100%;
+    max-width: 560px;
+  }
+
+  .features {
+    padding: 8px 24px 40px;
+  }
+
+  .cards {
+    flex-wrap: wrap;
+  }
+
+  .card {
+    /* Two cards per row: half the row minus half the 12px gap */
+    flex: 1 1 calc(50% - 6px);
+  }
+}
+
+/* Phone: menu on its own row, one card per row */
+@media (max-width: 600px) {
+  .site-header {
+    flex-direction: column;
+    align-items: flex-start;
+    gap: 8px;
+    padding: 16px 20px;
+  }
+
+  .site-nav {
+    display: flex;
+    flex-wrap: wrap;
+    column-gap: 20px;
+  }
+
+  .site-nav a {
+    margin-left: 0;
+    /* Vertical padding makes each link at least 24px tall to tap */
+    padding: 4px 0;
+  }
+
+  .hero {
+    padding: 32px 20px;
+  }
+
+  h1 {
+    font-size: 32px;
+  }
+
+  .features {
+    padding: 8px 20px 32px;
+  }
+
+  .card {
+    flex-basis: 100%;
+  }
 }
