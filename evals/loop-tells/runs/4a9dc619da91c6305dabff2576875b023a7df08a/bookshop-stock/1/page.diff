+
+/* Below this width the text and the table no longer fit side by side,
+   so the hero and the facts stack in one column. */
+@media (max-width: 1000px) {
+  .hero {
+    flex-direction: column;
+    align-items: stretch;
+    gap: 40px;
+  }
+
+  .hero-text {
+    max-width: 600px;
+  }
+
+  .preview {
+    flex: none;
+    width: 100%;
+    max-width: 600px;
+  }
+
+  .facts {
+    flex-direction: column;
+    gap: 16px;
+    max-width: calc(600px + 2 * var(--page-side));
+  }
+
+  .facts p {
+    max-width: 36em;
+  }
+
+  /* The title gets its own line, so each sentence fits on one line
+     at tablet width and no line ends with one or two words. */
