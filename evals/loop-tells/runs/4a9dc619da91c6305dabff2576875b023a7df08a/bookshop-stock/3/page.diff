+
+/*
+ * Below 1200px a third of the width is too narrow for the hero text,
+ * so stack the hero and the notes in one column.
+ */
+@media (max-width: 1200px) {
+  .hero,
+  .facts {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .preview {
+    grid-column: auto;
+  }
+
+  .hero {
+    row-gap: 40px;
+    padding-top: 48px;
+  }
+
+  /* 540px keeps the paragraphs at 75 characters per line or fewer. */
+  .hero-text,
+  .preview,
+  .facts p {
+    max-width: 540px;
+  }
+
+  .facts {
+    row-gap: 16px;
+  }
+}
+
+@media (max-width: 900px) {
+  :root {
+    --page-gutter: 32px;
+  }
+}
+
+/*
+ * Phone: logo and "Sign in" share the top row, the other links go on
+ * a second row. "display: contents" lets the nav's links sit directly
+ * in the header's flex row while the nav element stays in the markup.
+ * The empty ::after item takes a full row, which forces the line break.
+ */
+@media (max-width: 600px) {
+  :root {
+    --page-gutter: 20px;
+  }
+
+  .site-header {
+    flex-wrap: wrap;
+    gap: 10px 20px;
+    padding-top: 14px;
+    padding-bottom: 14px;
+  }
+
+  .site-header::after {
+    content: "";
+    order: 2;
+    flex-basis: 100%;
+    height: 0;
+    margin-top: -10px;
+  }
+
+  .site-nav {
+    display: contents;
+  }
+
+  .logo {
+    order: 0;
+    margin-right: auto;
+  }
+
+  .site-nav .nav-signin {
+    order: 1;
+  }
+
+  .site-nav a {
+    order: 3;
+    margin-left: 0;
+    white-space: nowrap;
+  }
+
+  h1 {
+    font-size: 32px;
+  }
+
+  th,
+  td {
+    padding: 9px 10px;
+  }
+
+  /* Keep the column labels and the titles on one line each. */
+  th,
+  td:first-child {
+    white-space: nowrap;
+  }
+}
