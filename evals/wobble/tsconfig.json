{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "../support/pinned-model-and-schema.ts"]
}
