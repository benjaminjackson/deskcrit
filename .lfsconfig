# Git LFS downloads no file by default (crit-yi0).
# Reason: a person who installs the plugin gets a clone of this whole repository, and
# needs none of its images. With this setting a clone holds small pointer files.
# A development checkout turns the setting off once: see "Develop" in README.md.
# Review trigger: Claude Code lets a repository make a sparse install the default.
[lfs]
	fetchexclude = *
