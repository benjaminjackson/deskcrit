{
  "name": "deskcrit-packs-tools",
  "private": true,
  "description": "Development tools for the first-party packs: the fixture renderer (crit-cy8.15, OQ-17). Never a dependency of the deskcrit package (NFR-3).",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup": "playwright install --only-shell chromium",
    "render": "node _renderer/render.ts render",
    "check": "node _renderer/render.ts check",
    "verify": "node _renderer/render.ts verify",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
