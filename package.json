{
  "name": "deskcrit",
  "version": "0.0.0",
  "description": "A command-line design critic that asks TypeSafe's Jev model typed questions about a picture of a design.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "deskcrit": "dist/crit.js",
    "crit": "dist/crit.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p evals/agreement",
    "lint": "biome check --error-on-warnings",
    "test": "vitest run",
    "test:live": "node evals/agreement/run-agreement.ts --live",
    "eval:agreement": "node evals/agreement/run-agreement.ts",
    "smoke": "node scripts/smoke.mjs",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.7.0",
    "sharp": "0.35.5"
  }
}
