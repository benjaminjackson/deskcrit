{
  "name": "deskcrit",
  "version": "0.0.0",
  "description": "Development tooling for the deskcrit Claude Code plugin: the design-critic skill, its guideline packs, and their evaluations.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p evals/agreement && tsc --noEmit -p evals/adversarial && tsc --noEmit -p evals/critic && tsc --noEmit -p evals/loop-tells",
    "lint": "biome check --error-on-warnings",
    "test": "vitest run",
    "eval:critic": "node evals/critic/run-critic.ts",
    "eval:critic:praise-text": "node evals/critic/praise-text.ts --replay",
    "eval:critic:tells": "node evals/critic/tells.ts --replay --skill-commit 15fe41698c70411d5cffd822320277c11552224e",
    "eval:critic:compare": "node evals/critic/compare.ts --replay",
    "eval:critic:detect": "node evals/critic/detect.ts --replay",
    "eval:critic:detect:refute": "node evals/critic/detect.ts --replay --refute --skill-commit 3a8d079b393465ca12ca83931416acd49717d971 --refuter-commit 0bad6cc60138f58ea84a2e2fd373375bbce1d3a3",
    "eval:critic:detect:deep": "node evals/critic/detect.ts --replay --deep --skill-commit b8ce97507396df2d86bdc20edc3a5fad21873ccc --beside 3a8d079b393465ca12ca83931416acd49717d971",
    "eval:critic:repeat": "node evals/critic/repeat.ts --replay",
    "ci": "npm run lint && npm run typecheck && npm test",
    "eval:critic:sets": "node evals/critic/sets.ts --replay",
    "eval:loop-tells": "node evals/loop-tells/run.ts replay --plugin-commit 4a9dc619da91c6305dabff2576875b023a7df08a",
    "eval:critic:picker": "node evals/critic/picker.ts --replay",
    "eval:critic:thresholds": "node evals/critic/thresholds.ts --replay",
    "eval:critic:recheck-tells": "node evals/critic/recheck-tells.ts --replay --skill-commit 4a9dc619da91c6305dabff2576875b023a7df08a"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "private": true
}
