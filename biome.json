{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "schemas/**",
      "scripts/**",
      "spike/*.ts",
      "spike/package.json",
      "spike/tsconfig.json",
      "vitest.config.ts",
      "package.json",
      "tsconfig.json",
      "biome.json",
      "packs/_renderer/*.ts",
      "packs/_renderer/*.js",
      "packs/_renderer/*.css",
      "packs/_example/templates/*.css",
      "packs/package.json",
      "packs/tsconfig.json",
      "tsconfig.lib.json"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noDefaultExport": "error"
      },
      "performance": {
        "noBarrelFile": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["vitest.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ]
}
