{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "schemas/**",
      "scripts/**",
      "spike/*.ts",
      "spike/package.json",
      "spike/tsconfig.json",
      "evals/*.ts",
      "evals/support/*.ts",
      "evals/support/*.mjs",
      "vitest.config.ts",
      "package.json",
      "tsconfig.json",
      "biome.json",
      "packs/_renderer/*.ts",
      "packs/_renderer/*.js",
      "packs/_renderer/*.css",
      "packs/_example/templates/*.css",
      "packs/package.json",
      "packs/tsconfig.json",
      "evals/agreement/*.ts",
      "evals/agreement/tsconfig.json",
      "evals/wobble/*.ts",
      "evals/wobble/tsconfig.json",
      "evals/adversarial/*.ts",
      "evals/adversarial/tsconfig.json",
      "evals/adversarial/pairs.json",
      "evals/packs-test/*.ts",
      "evals/packs-test/tsconfig.json",
      "tsconfig.lib.json",
      ".claude-plugin/marketplace.json",
      "plugin/.claude-plugin/plugin.json"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noDefaultExport": "error"
      },
      "performance": {
        "noBarrelFile": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["vitest.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ]
}
